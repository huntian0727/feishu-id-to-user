{
  "name": "feishu-id-to-user",
  "version": "1.0.0",
  "type": "module",
  "description": "Feishu Base sidebar plugin that converts User IDs to user fields",
  "scripts": {
    "dev": "concurrently -k \"npm:dev:server\" \"npm:dev:web\"",
    "dev:web": "vite",
    "dev:server": "node server/index.mjs",
    "dev:server:watch": "node --watch-path=server server/index.mjs",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "start": "node server/index.mjs"
  },
  "keywords": [],
  "output": "dist",
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@types/react": "^18.0.15",
    "@types/react-dom": "^18.0.6",
    "@vitejs/plugin-react": "^2.0.0",
    "concurrently": "^10.0.5",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "typescript": "^4.7.4",
    "vite": "^3.0.4"
  },
  "dependencies": {
    "@douyinfe/semi-foundation": "^2.38.0",
    "@douyinfe/semi-ui": "^2.36.0",
    "@lark-base-open/js-sdk": "^1.0.2",
    "dotenv": "^18.0.1",
    "express": "^5.2.1",
    "i18next": "^23.5.1",
    "i18next-browser-languagedetector": "^7.1.0",
    "react-i18next": "^13.2.2",
    "reset-css": "^5.0.1"
  }
}
